<%- include('partials/header') %>
<h1>Server-side Rendered Books List</h1>
<table>
  <tr>
    <th>Title</th><th>Author</th><th>Year</th><th>Genre</th><th>Pages</th>
  </tr>
  <% books.forEach(function(book) { %>
    <tr>
      <td><%= book.title %></td>
      <td><%= book.author %></td>
      <td><%= book.year %></td>
      <td><%= book.genre %></td>
      <td><%= book.pages %></td>
    </tr>
  <% }) %>
</table>